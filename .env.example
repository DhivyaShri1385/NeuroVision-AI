# ============================================================
# NeuroVision AI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ----- Data Paths -----
# Absolute path to the root of the brain tumor dataset
DATASET_ROOT=C:/Users/loges/OneDrive/Desktop/Github/Brain_Tumor/brain tumor dataset

# Absolute path to the neurovision-ai project root
PROJECT_ROOT=C:/Users/loges/OneDrive/Desktop/Logesh Project/neurovision-ai

# ----- Training Config -----
RANDOM_SEED=42
BATCH_SIZE=32
NUM_WORKERS=4

# ----- Database (Phase 5) -----
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/neurovision_db

# ----- API Security (Phase 5) -----
SECRET_KEY=your-super-secret-jwt-key-change-in-production
API_HOST=0.0.0.0
API_PORT=8000

# ----- Environment -----
ENVIRONMENT=development
LOG_LEVEL=INFO
